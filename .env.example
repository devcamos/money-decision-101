# Local development only. Next.js reads this after copying to .env.local.
# Run OPA separately with the canonical policy and evidence files.
# Hosted Vercel web receives OPA_URL via its private service binding:
# do not copy this localhost value into hosted project environment variables.
OPA_URL=http://127.0.0.1:8181

# Public, optional override for the result-screen external support link.
# Blank retains the default https://buymeacoffee.com/devoamos.
# Never put credentials in NEXT_PUBLIC_* values.
NEXT_PUBLIC_SUPPORT_URL=
